# Base URL the app uses to reach the backend API.
#
# - Expo web / Android emulator on the same machine: the default below works.
# - Physical phone via Expo Go: the phone usually can't reach your dev machine
#   directly (different network / eduroam isolation). Expose the backend with a
#   free Cloudflare quick tunnel and use that URL instead:
#       cloudflared tunnel --url http://localhost:8000
#       EXPO_PUBLIC_API_URL=https://<random>.trycloudflare.com/api/v1
#   Note: EXPO_PUBLIC_* vars are inlined at bundle time — restart `expo start`
#   after changing this file.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
